# Copie para .env (cp .env.example .env). O Bun carrega o .env automaticamente.
# Todas as variáveis são validadas na inicialização; valor inválido impede o boot.

# Ambiente. "test" habilita ganchos de injeção de falha usados pela suíte de testes.
NODE_ENV=development
# Porta HTTP da instância.
PORT=3000

# --- PostgreSQL ---
DATABASE_URL=postgres://wager:wager@localhost:5432/wager
# Tamanho máximo do pool de conexões por instância.
DB_POOL_MAX=20
# Tempo máximo esperando um lock de linha (SET LOCAL lock_timeout) antes de virar falha transitória.
DB_LOCK_TIMEOUT_MS=5000

# --- SQS (MiniStack) ---
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
# Credenciais falsas: o emulador não as valida, mas o SDK exige que existam.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
QUEUE_NAME_TRANSACTIONS=wager-transactions.fifo
QUEUE_NAME_DLQ=wager-transactions-dlq.fifo
# Destino dos eventos de integração publicados pela outbox.
QUEUE_NAME_EVENTS=wager-events.fifo

# --- Papéis desta instância (todos ligados por padrão) ---
RUN_HTTP=true
RUN_CONSUMER=true
RUN_OUTBOX_PUBLISHER=true
RUN_PENDING_REFERENCE_WORKER=true

# --- Consumidor SQS ---
# Nome do consumidor; compõe a chave do inbox (consumer_name, message_id).
CONSUMER_NAME=wager-transactions-consumer
# Tentativas do app antes de mandar para a DLQ (menor que o maxReceiveCount da fila, que é 6).
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_VISIBILITY_TIMEOUT_S=30
# Long polling. Nos testes usamos 1.
CONSUMER_WAIT_TIME_S=10
# Base do backoff de retry transitório (segundos): base * 2^(tentativa-1), máximo 60. 0 = devolve na hora.
CONSUMER_RETRY_BASE_S=2
# Tempo para concluir a mensagem em andamento após SIGTERM.
SHUTDOWN_TIMEOUT_MS=25000

# --- Publisher da outbox ---
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
# Por quanto tempo um lote reivindicado fica reservado para esta instância.
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_BACKOFF_MS=60000

# --- Worker de PENDING_REFERENCE ---
PENDING_REF_POLL_INTERVAL_MS=2000
PENDING_REF_BATCH_SIZE=20
PENDING_REF_LEASE_MS=30000
# Backoff: base * 2^(tentativa-1), limitado ao máximo.
PENDING_REF_BASE_DELAY_MS=5000
PENDING_REF_MAX_DELAY_MS=300000
# Esgotadas as tentativas, a transação vira REJECTED (REFERENCE_NOT_FOUND_EXPIRED).
PENDING_REF_MAX_ATTEMPTS=10

# --- Observabilidade ---
LOG_LEVEL=info

# Mata o processo entre o commit e o ack da mensagem. Só é honrado com NODE_ENV=test.
FAULT_KILL_AFTER_COMMIT=0
